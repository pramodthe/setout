      "source": "NCC2022-HP-10.2",
      "applies_to": "shower_wall",
      "parameter": "waterproof_above_floor_substrate_mm",
      "operator": ">=",
      "value": 1800,
      "unit": "mm",
      "text": "Shower area walls must be waterproof to at least 1800 mm above the floor substrate.",
      "drives_geometry": false
    },
    {
