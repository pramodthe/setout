      "parameter": "water_resistant_width_each_side_of_taps_mm",
      "operator": ">=",
      "value": 75,
      "unit": "mm",
      "text": "Wall area behind a washing machine must be water resistant at least 75 mm to each side of the tap outlets.",
      "drives_geometry": false
    },
    {
