.env
__pycache__/
*.pyc
node_modules/
data/videos/*
data/frames/*
data/manuals/*
data/demo/
!data/**/.gitkeep
killcheck_results.json
.DS_Store
Thumbs.db

# Source documents are never committed - see .claude/rules/source-documents.md
# Everything under data/ (drawings, DWG/DXF, scans, datasets) stays local;
# only the .gitkeep placeholders are tracked.
data/**
!data/**/
!data/**/.gitkeep
*.pdf
data/**/*.txt
data/**/*.json
**/ocr_output/
**/*_extracted.*

# Vertical-slice runtime (gitignored)
var/
.venv/

# Web build output and deps
web/dist/
web/node_modules/
