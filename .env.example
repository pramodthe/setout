# Meta Model API — https://dev.meta.ai/  (API key from the dashboard)
META_API_KEY=

# Muse Wonder for rule extraction. ~$4/1M input, $20/1M output.
# Use muse-spark-1.3-contributor while developing: far cheaper, but your data
# is used to improve Meta's products. Switch to muse-wonder-1.0 for final runs.
META_MODEL=muse-wonder-1.0
META_API_BASE=https://api.meta.ai/v1

# SAM 3.1 — verified 27 Oct against https://dev.meta.ai/docs/sam/segmenting
# Calls go to {META_API_BASE}/responses. There is no separate SAM endpoint.
META_SAM_MODEL=sam-3.1

# Local runtime storage for uploads, specs, builds (gitignored). Names only.
SETOUT_VAR=
