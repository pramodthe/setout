# Meta Model API: https://dev.meta.ai/ (API key from the dashboard)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# The model that plans, builds and checks. The contributor tier is far cheaper, but your data
# is used to improve Meta's products.
MODEL_API_MODEL=muse-spark-1.3-contributor

# Runtime settings below must be exported in the process environment.
# Where scenes, uploads and the database live (gitignored). Defaults to var/.
SETOUT_VAR=

# Optional finishing pass after a model is ready: off (default), local, or modal.
# local uses an installed Blender; modal needs `modal deploy builder/render_sandbox.py`.
SETOUT_RENDERER=off
# Optional executable override for local rendering (otherwise detected).
SETOUT_BLENDER=
